[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "transform": {
          "queryTransform": {
            "removeParams": ["onepasswdfill", "onepasswdvault"]
          }
        }
      }
    },
    "condition": {
